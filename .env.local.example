# CrisisCoordinator - Environment Variables
# Copy to .env.local and fill in your own values

# Anthropic Claude API key (kept server-side only)
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX

# Supabase project configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key # server-side only, never expose to client

# Next.js needs public env vars for browser Supabase client (can match above values)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key

# Optional: override Next.js node environment (development|production)
NODE_ENV=development
